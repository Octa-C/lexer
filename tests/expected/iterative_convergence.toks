<KW_FUNC_FUNCTION,>
<IDENTIFIER, main>
<PUNCTUATION_LPAREN,>
<PUNCTUATION_RPAREN,>
<PUNCTUATION_ARROW,>
<DT_SCALAR, i32>
<PUNCTUATION_LBRACE,>
<DT_SCALAR, f32>
<IDENTIFIER, val>
<OPERATORS_ASSIGNMENT, =>
<CONSTANTS_FLOAT_LITERAL, 100.0>
<PUNCTUATION_SEMICOLON,>
<DT_SCALAR, i32>
<IDENTIFIER, steps>
<OPERATORS_ASSIGNMENT, =>
<CONSTANTS_INT_LITERAL, 0>
<PUNCTUATION_SEMICOLON,>
<KW_LOOPS_UNTIL,>
<PUNCTUATION_LPAREN,>
<IDENTIFIER, val>
<OPERATORS_RELATIONAL_AND_COMPARISON_OPS_LESS,>
<CONSTANTS_FLOAT_LITERAL, 1.0>
<KW_WORDBASED_LOGICREL_OPS_OR,>
<IDENTIFIER, steps>
<KW_WORDBASED_LOGICREL_OPS_IS,>
<CONSTANTS_INT_LITERAL, 20>
<PUNCTUATION_RPAREN,>
<PUNCTUATION_LBRACE,>
<IDENTIFIER, val>
<OPERATORS_ASSIGNMENT, /=>
<CONSTANTS_FLOAT_LITERAL, 2.0>
<PUNCTUATION_SEMICOLON,>
<IDENTIFIER, steps>
<OPERATORS_ASSIGNMENT, +=>
<CONSTANTS_INT_LITERAL, 1>
<PUNCTUATION_SEMICOLON,>
<PUNCTUATION_RBRACE,>
<IDENTIFIER, printf>
<PUNCTUATION_LPAREN,>
<CONSTANTS_STRING_LITERAL, "Converged in %d steps.">
<PUNCTUATION_COMMA,>
<IDENTIFIER, steps>
<PUNCTUATION_RPAREN,>
<PUNCTUATION_SEMICOLON,>
<KW_FUNC_RETURN,>
<CONSTANTS_INT_LITERAL, 0>
<PUNCTUATION_SEMICOLON,>
<PUNCTUATION_RBRACE,>
<COMPILER_EOF,>
